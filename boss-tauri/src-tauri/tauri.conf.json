{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BossJob-Helper",
  "version": "1.1.1",
  "identifier": "cc.luckyioo.bosshelper",
  "build": {
    "frontendDist": "../sidepanel"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
